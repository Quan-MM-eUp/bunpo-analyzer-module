{
 "version": "0.1",
 "note": "Luat do mau ngu phap cap N4.",
 "rules": [
  {
   "id": 245,
   "name": "～が　ある",
   "patterns": [
    [
     {
      "pos": "noun",
      "ctx": true
     },
     {
      "surface": "が",
      "pos": "prt"
     },
     {
      "base": "ある",
      "pos": "verb"
     }
    ]
   ],
   "examples": [
    "今夜たくさんの宿題がある。",
    "明日は会議があります。"
   ],
   "not_examples": [
    "雨が降る。",
    "時間はある。"
   ]
  },
  {
   "id": 234,
   "name": "～Vている",
   "patterns": [
    [
     {
      "pos": "verb",
      "ctx": true
     },
     {
      "surface": [
       "て",
       "で"
      ],
      "pos": "prt",
      "pos2": "接続助詞"
     },
     {
      "base": "いる",
      "pos": "verb"
     }
    ]
   ],
   "examples": [
    "雨が降っている。",
    "子供たちが遊んでいる。",
    "彼はまだ寝ていない。",
    "図書館で日本語を勉強しています。"
   ],
   "not_examples": [
    "猫がいる。",
    "食べてから寝る。"
   ]
  },
  {
   "id": 242,
   "name": "～かもしれない",
   "patterns": [
    [
     {
      "surface": "か"
     },
     {
      "surface": "も"
     },
     {
      "base": "しれる"
     }
    ]
   ],
   "examples": [
    "明日は雨が降るかもしれない。",
    "彼は来ないかもしれません。",
    "あの人は先生かもしれない。"
   ],
   "not_examples": [
    "何か食べたい。",
    "彼も来た。"
   ]
  }
 ],
 "llm_only": []
}