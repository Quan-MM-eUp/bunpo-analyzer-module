# Thu muc chua grammar/grammar_lib.json, word/word_lib.json, i18n/*.json
BUNPO_DATA_DIR=..
BUNPO_DEFAULT_LANG=vi
BUNPO_MAX_CHARS=100

# LLM: doi nha cung cap / model chi can sua o day (muc 9, ghi chu)
BUNPO_LLM_PROVIDER=gemini
BUNPO_LLM_MODEL=gemini-3.1-flash-lite
BUNPO_LLM_FALLBACK_MODEL=gemini-3-flash
BUNPO_LLM_TIMEOUT_S=20
BUNPO_GEMINI_API_KEY=
