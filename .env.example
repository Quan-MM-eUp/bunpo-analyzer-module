# Thu muc chua grammar/grammar_lib.json, word/word_lib.json, i18n/*.json
BUNPO_DATA_DIR=..
BUNPO_DEFAULT_LANG=vi
BUNPO_MAX_CHARS=100

# LLM: doi nha cung cap / model chi can sua o day (muc 9, ghi chu)
# Tam dung OpenAI qua LLM gateway noi bo (key dev, khong dung cho production)
BUNPO_LLM_PROVIDER=openai
BUNPO_LLM_MODEL=gpt-5-mini
BUNPO_LLM_FALLBACK_MODEL=gpt-4.1
BUNPO_LLM_TIMEOUT_S=30
# Chi cho model "suy nghi" (gpt-5-mini...): minimal | low | medium | high
BUNPO_LLM_REASONING_EFFORT=low
# "Dich nhe" khi cau da co trong cache bang ngon ngu khac (muc 12.5)
BUNPO_LLM_LIGHT_MODEL=gpt-4.1-mini
BUNPO_OPENAI_BASE_URL=https://llm-api.eup.ai/v1
BUNPO_OPENAI_API_KEY=
# BUNPO_GEMINI_API_KEY=

# Cache (buoc 2.6): memory | redis | none. redis can: pip install -e ".[redis]"
BUNPO_CACHE_BACKEND=memory
# BUNPO_CACHE_URL=redis://localhost:6379/0
BUNPO_CACHE_TTL_S=2592000

# Dich kho bang Claude API (scripts/translation/api_translate.py). Chi dung tren may, khong commit .env
# ANTHROPIC_API_KEY=

# Tu dien tra nghia tu: kho (word_lib, chi tieng Viet) | mazii (API Mazii, da ngon ngu)
BUNPO_DICT_PROVIDER=mazii
# public.pem cua app Mazii (giai ma ket qua). Khong commit file nay.
BUNPO_MAZII_PEM_PATH=../secrets/public.pem
# BUNPO_MAZII_PEM=          # hoac noi dung pem truc tiep (server / bien moi truong bi mat)
# BUNPO_DICT_TIMEOUT_S=1.5  # moi lan goi; tong cho ca cau toi da 2 x
